    {
      "id": "2674174e-add8-527d-8a2e-106da7e8d979",
      "name": "Inspect priority URLs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1320,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://searchconsole.googleapis.com/v1/urlInspection/index:inspect",
        "authentication": "genericCredentialType",
        "genericAuthType": "oAuth2Api",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({inspectionUrl: $json.url, siteUrl: 'sc-domain:baialupo.com', languageCode: 'en-US'}) }}",
        "options": {
          "timeout": 30000,
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 1000
            }
          },
          "response": {
            "response": {
              "neverError": true,
              "responseFormat": "json"
            }
          }
        }
      },
      "onError": "continueRegularOutput",
      "retryOnFail": false,
      "notes": "Associare OAuth2 generico Google con scope https://www.googleapis.com/auth/webmasters.readonly; nessun ID Google inventato. Binding/property/quota da qualificare. Nessun retry automatico."
    },
    {
      "id": "0390b757-fd5a-5cf5-8036-e8a23288239e",
      "name": "Classify observations",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Bounded to the 25 configured URLs. Durable state belongs only to native Data Table.\nconst history = new Map($('Load history').all().filter(item => item.json.url).map(item => [item.json.url, item.json]));\nconst day = $('Observation date').first().json.observationDay;\nconst yesterday = new Date(Date.parse(day + 'T00:00:00Z') - 86400000).toISOString().slice(0, 10);\nreturn $input.all().map((item, index) => {\n  const url = $('Priority URLs').all()[index].json.url;\n  const previous = history.get(url) || {};\n  const result = item.json.body || item.json;\n  const inspection = result.inspectionResult?.indexStatusResult;\n  // coverageState describes the observation; canonical is present for an indexed PASS.\n  // Missing data never replaces an indexed baseline or confirms a negative observation.\n  if (result.error || !inspection || !['PASS', 'FAIL', 'NEUTRAL'].includes(inspection.verdict)\n      || !inspection.coverageState || (inspection.verdict === 'PASS' && !inspection.googleCanonical)) {\n    const code = result.error?.code || item.json.statusCode || '';\n    const status = result.error?.status || (result.error ? 'OAUTH_O_RICHIESTA_FALLITA' : 'DATI_MANCANTI');\n    return {json: {url, valid: false, diagnostic: 'Inspection indisponibile: ' + code + ' ' + status\n      + '; nessun retry automatico, nessuna conferma o modifica della baseline'}, pairedItem: {item: index}};\n  }\n  const state = {url, indexedBaseline: previous.indexedBaseline === true,\n    baselineDay: previous.baselineDay || '', candidateState: previous.candidateState || '',\n    candidateDay: previous.candidateDay || '', consecutiveCount: previous.consecutiveCount || 0,\n    observationDay: previous.observationDay || '', alertedState: previous.alertedState || ''};\n  let shouldAlert = false;\n  let significant = '';\n  if (inspection.googleCanonical && inspection.googleCanonical !== url) {\n    significant = 'CANONICAL_INATTESO: ' + inspection.googleCanonical;\n  } else if (inspection.verdict === 'FAIL' && ['BLOCKED_BY_META_TAG', 'BLOCKED_BY_HTTP_HEADER'].includes(inspection.indexingState)) {\n    significant = inspection.indexingState;\n  } else if (['FAIL', 'NEUTRAL'].includes(inspection.verdict)) {\n    significant = 'NON_INDICIZZATA: ' + inspection.coverageState;\n  }\n  if (day > state.observationDay) {\n    state.observationDay = day;\n    if (inspection.verdict === 'PASS' && !significant) {\n      state.indexedBaseline = true;\n      state.baselineDay = day;\n      state.candidateState = '';\n      state.candidateDay = '';\n      state.consecutiveCount = 0;\n      state.alertedState = '';\n    } else if (significant && state.indexedBaseline) {\n      state.consecutiveCount = state.candidateState === significant && state.candidateDay === yesterday\n        ? Math.min(state.consecutiveCount + 1, 2) : 1;\n      state.candidateState = significant;\n      state.candidateDay = day;\n      shouldAlert = state.consecutiveCount === 2 && state.alertedState !== significant;\n      if (shouldAlert) state.alertedState = significant;\n    }\n  }\n  const message = ':warning: *Baialupo SEO: transizione negativa confermata*\\n'\n    + url + '\\nEsito: ' + significant + '\\nBaseline indicizzata: ' + state.baselineDay\n    + '\\nConferma: due osservazioni giornaliere consecutive; ' + yesterday + ' / ' + day\n    + '\\nProperty: sc-domain:baialupo.com. URL Inspection osserva l’indice Google, non il sito live.';\n  return {json: {...state, valid: true, shouldAlert, message}, pairedItem: {item: index}};\n});"
      },
      "notes": "Unico Code applicativo bounded: classificazione/conferma e formattazione. Stato e dedup solo Data Table nativa; prova di necessità approvata #27."
    },
