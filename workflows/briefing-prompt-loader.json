    {
      "id": "validate",
      "name": "Seleziona e verifica prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        100
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const key = $('Verifica chiave').first().json.chiave;\nconst rows = $input.all().map(item => item.json);\nfunction exactlyOne(k) {\n  const found = rows.filter(row => row.chiave === k);\n  if (found.length !== 1) throw new Error(`Chiave ${k}: attesa una riga, trovate ${found.length}`);\n  if (typeof found[0].prompt !== 'string' || !found[0].prompt.trim()) throw new Error(`Prompt vuoto per ${k}`);\n  return found[0];\n}\nconst common = exactlyOne('contratto-comune');\nconst job = exactlyOne(key);\nreturn [{json:{chiave:job.chiave,titolo:job.titolo,contratto_comune:common.prompt,prompt:job.prompt}}];"
      }
    }
