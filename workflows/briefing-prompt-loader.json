      "parameters": {
        "jsCode": "const chiave = $input.first().json.chiave;\nif (typeof chiave !== 'string' || !/^job-\\d{2}$/.test(chiave)) throw new Error('Specificare una chiave incarico valida, per esempio job-05');\nreturn [{json:{chiave}}];"
